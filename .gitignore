build*/
compile_commands.json
crash-*
fuzz/corpus/
fuzz/fuzz_secrets
# Synthetic fixtures are regenerated by the test harness, not committed.
tests/samples/
__pycache__/
*.pyc
# Vulnerability-feed mirrors and other large local data are not committed, but
# the small vendored reference corpora (public keys/certs) are tracked.
data/*
!data/bootkeys/
!data/keycorpus/
# Debian packaging build artifacts (debian/ sources are tracked; outputs are not)
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
/debian/.debhelper/
/debian/mithril/
/debian/tmp/
/obj-*/
# Private running dev log — kept locally, never committed.
PROGRESS.md
# Internal toolkit skill file — kept locally, never committed.
SKILL.md
